{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "docs/**",
      "assets/**",
      "notes.md",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "android/**",
      "ios/**",
      "www/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "capacitor.config.json",
      "flit-session-handoff.md"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
